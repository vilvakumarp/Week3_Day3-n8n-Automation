    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Clean this student enrollment row and return only a JSON object.\nRaw data\" {{ JSON.stringify($json) }}\n\nRules:\n - Name : Title case (Manoj K)\n - Email : if invalid set INVALID_EMAIL\n - Phone: if less than 10 digit set MISSING\n - Course: only python or Machine learning or Data Science\n - Fee_paid: yes/Yes/YES = True, no/NO/No = False\n - City: Title Case, empty = UNKNOWN\n - Enrolled_Date: convert to YYYY-MM-DD\n\nReturn only raw JSON. NO explanation. No Markdown.",
        "hasOutputParser": true,
        "messages": {
          "messageValues": []
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        304,
        -224
      ],
      "id": "2cf8d83c-81e7-4c15-9d2c-2585bbcd7a1f",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nreturn items.map(item => {\n  let student = item.json;\n\n  // Parse JSON stored inside the text field\n  if (typeof student.text === \"string\") {\n    try {\n      student = JSON.parse(student.text);\n    } catch (error) {\n      // Keep the original data if parsing fails\n      student = { ...item.json };\n    }\n  }\n\n  // Clean all string values without removing available fields\n  for (const key of Object.keys(student)) {\n    if (typeof student[key] === \"string\") {\n      student[key] = student[key].trim();\n    }\n  }\n\n  // Validate email only when the field exists\n  if (Object.hasOwn(student, \"Email\")) {\n    const email = student.Email;\n\n    student.Email =\n      typeof email === \"string\" &&\n      /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email.trim())\n        ? email.trim().toLowerCase()\n        : null;\n  }\n\n  // Standardize course capitalization when available\n  if (typeof student.Course === \"string\" && student.Course) {\n    student.Course =\n      student.Course.charAt(0).toUpperCase() +\n      student.Course.slice(1).toLowerCase();\n  }\n\n  // Clean phone only when the field exists\n  if (Object.hasOwn(student, \"Phone\") && student.Phone != null) {\n    const phone = String(student.Phone).replace(/\\D/g, \"\");\n    student.Phone = phone.length === 10 ? phone : null;\n  }\n\n  // Preserve missing fields as missing; do not invent values\n  return { json: student };\n});\n"
      },
